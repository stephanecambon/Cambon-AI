---
import Base from '../../../layouts/Base.astro';
import ProjectList from '../../../components/ProjectList.astro';
import { projectsJsonLd } from '../../../lib/seo';
import { getProjets, slugOf } from '../../../lib/projets';
import { texts, routes } from '../../../i18n';

const t = texts.en.meta;
const list = (await getProjets('en')).map((p) => ({ title: p.data.title, slug: slugOf(p) }));
---
<Base lang="en" alternates={routes.projects} title={t.projectsTitle} description={t.projectsDescription} jsonLd={projectsJsonLd('en', list)}>
  <ProjectList lang="en" />
</Base>
