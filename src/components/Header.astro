---
import Logo from './Logo.astro';
import { texts, routes, anchors, type Lang, type Alternates } from '../i18n';
import { bookingHref } from '../config';

interface Props {
  lang: Lang;
  /** Adresse de la page courante dans chaque langue. */
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const t = texts[lang].nav;
const home = routes.home[lang];
const a = anchors[lang];
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const otherHref = alternates[other];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href={home} aria-label={t.logoLabel}><Logo /></a>

    <div class="site-header__bar">
    <nav class="site-header__nav" aria-label={t.mainLabel}>
      <a href={`${home}#${a.approach}`}>{t.approach}</a>
      <a href={routes.projects[lang]}>{t.projects}</a>
      <a href={`${home}#${a.about}`}>{t.about}</a>
    </nav>

    <p class="lang-switch" aria-label={t.langLabel}>
      {lang === 'fr' ? (
        <>
          <span aria-current="true">FR</span>
          <span aria-hidden="true">·</span>
          <a href={otherHref} hreflang="en" lang="en">EN</a>
        </>
      ) : (
        <>
          <a href={otherHref} hreflang="fr" lang="fr">FR</a>
          <span aria-hidden="true">·</span>
          <span aria-current="true">EN</span>
        </>
      )}
    </p>
    </div>

    <a class="site-header__cta btn btn--primary btn--small" href={bookingHref}>{t.booking}</a>
  </div>
</header>

<style>
  /* Tétière blanche, collée en haut de l'écran */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    border-bottom: 1px solid var(--rule);
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-areas: 'logo nav lang cta';
    align-items: center;
    gap: 12px 24px;
    padding-block: 16px;
  }
  .site-header__bar {
    display: contents;
  }
  .site-header__logo {
    grid-area: logo;
    text-decoration: none;
  }
  .site-header__nav {
    grid-area: nav;
    justify-self: center;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
  }
  .site-header__nav a {
    font-weight: 500;
    text-decoration: none;
    color: var(--text-2);
  }
  .site-header__nav a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .lang-switch {
    grid-area: lang;
    display: flex;
    gap: 0.35em;
    margin: 0;
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .lang-switch [aria-current] {
    color: var(--ink);
  }
  .lang-switch a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .lang-switch a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .site-header__cta {
    grid-area: cta;
  }

  /* Écrans étroits : logo + bouton sur la 1re ligne, menu + langue sur la 2de */
  @media (max-width: 860px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'logo cta'
        'bar bar';
      gap: 14px 16px;
    }
    .site-header__bar {
      grid-area: bar;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .site-header__nav {
      gap: 4px 22px;
    }
  }
  @media (max-width: 400px) {
    .site-header__nav {
      gap: 4px 16px;
    }
  }

  /* ---------- Mobile : zones tactiles d'au moins 44 px ---------- */
  @media (max-width: 860px) {
    .site-header__inner {
      row-gap: 4px;
    }
    .site-header__nav a,
    .lang-switch a,
    .lang-switch [aria-current] {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
    .lang-switch a,
    .lang-switch [aria-current] {
      justify-content: center;
      min-width: 44px;
    }
    .lang-switch {
      gap: 0;
      align-items: center;
    }
  }

  /* ---------- Mobile + JavaScript : la ligne de navigation se masque
     quand on descend et revient quand on remonte. Sans JS : inchangé. ---------- */
  @media (max-width: 860px) {
    :global(html.js-hdr) .site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
    }
    :global(html.js-hdr body) {
      padding-top: var(--header-full-h, 0px);
    }
    :global(html.js-hdr) .site-header__bar {
      max-height: 60px;
      overflow: hidden;
      transition: max-height 0.2s ease, opacity 0.2s ease;
    }
    :global(html.js-hdr) .site-header.nav-hidden .site-header__bar {
      max-height: 0;
      opacity: 0;
      visibility: hidden;
      transition: max-height 0.2s ease, opacity 0.15s ease, visibility 0s linear 0.2s;
    }
    :global(html.js-hdr) .site-header.nav-hidden .site-header__inner {
      row-gap: 0;
    }
  }
  @media (max-width: 860px) and (prefers-reduced-motion: reduce) {
    :global(html.js-hdr) .site-header__bar {
      transition: none;
    }
  }

  /* ---------- Logo : le carré « AI » ressort puis s'emboîte (0,7 s) ----------
     Déclenché par JavaScript (classe .is-animating) au survol ou au focus
     clavier du lien. Sans JS, sur mobile ou si l'utilisateur réduit les
     animations : logo statique. 60px = 60 unités du dessin (viewBox 240),
     donc proportionnel à la taille d'affichage. */
  @keyframes logo-emboite {
    0% {
      transform: translateX(0);
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
    45% {
      transform: translateX(60px);
      animation-timing-function: cubic-bezier(0.6, 0, 0.85, 0.9);
    }
    100% {
      transform: translateX(0);
    }
  }
  .site-header__logo.is-animating :global(.logo-ai) {
    animation: logo-emboite 0.7s both;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__logo.is-animating :global(.logo-ai) {
      animation: none;
    }
  }
</style>

<script>
  // Mobile : masque la ligne de navigation en descendant, la réaffiche en remontant.
  // Le logo et « Prendre rendez-vous » restent toujours visibles.
  // Logo : animation d'emboîtement, une fois par survol (ou focus clavier).
  // Elle se joue toujours en entier : la classe n'est retirée qu'à la fin.
  const logoLink = document.querySelector<HTMLAnchorElement>('.site-header__logo');
  const logoAi = logoLink?.querySelector('.logo-ai');
  if (logoLink && logoAi) {
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const play = () => {
      if (reduced.matches || logoLink.classList.contains('is-animating')) return;
      logoLink.classList.add('is-animating');
    };
    logoLink.addEventListener('mouseenter', () => {
      if (canHover.matches) play();
    });
    logoLink.addEventListener('focus', () => {
      if (logoLink.matches(':focus-visible')) play();
    });
    logoAi.addEventListener('animationend', () => logoLink.classList.remove('is-animating'));
  }

  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const root = document.documentElement;
    const mobile = window.matchMedia('(max-width: 860px)');
    const measure = () => {
      if (!header.classList.contains('nav-hidden')) {
        root.style.setProperty('--header-full-h', `${header.offsetHeight}px`);
      }
    };
    root.classList.add('js-hdr');
    measure();
    document.fonts?.ready.then(measure);

    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = Math.max(0, window.scrollY);
      if (!mobile.matches || y < header.offsetHeight) {
        header.classList.remove('nav-hidden');
        lastY = y;
        return;
      }
      const delta = y - lastY;
      if (Math.abs(delta) < 8) return;
      header.classList.toggle('nav-hidden', delta > 0 && !header.contains(document.activeElement));
      lastY = y;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    window.addEventListener('resize', () => {
      header.classList.remove('nav-hidden');
      measure();
    });
    header.addEventListener('focusin', () => header.classList.remove('nav-hidden'));
  }
</script>
