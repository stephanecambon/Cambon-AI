---
import { texts, rich, plain, routes, type Lang } from '../i18n';
import { bookingHref } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = texts[lang].hero;
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="eyebrow"><span class="eyebrow__num">00 /</span><span>{plain(t.eyebrow, lang)}</span></p>
      <h1 class="hero__title" set:html={rich(t.title, lang)} />
      <p class="hero__subtitle">{plain(t.subtitle, lang)}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={bookingHref}>{t.ctaPrimary}</a>
        <a class="btn btn--outline" href={routes.projects[lang]}>{t.ctaSecondary}</a>
      </div>
    </div>

    <aside class="fiche" aria-label={t.factsLabel}>
      <p class="fiche__label">{t.factsLabel}</p>
      <dl class="fiche__list">
        {t.facts.map(([key, value]) => (
          <div class="fiche__row">
            <dt>{plain(key, lang)}</dt>
            <dd>{plain(value, lang)}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(48px, 9vw, 112px) clamp(56px, 9vw, 112px);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 320px);
    gap: 48px 64px;
    align-items: end;
  }
  .hero__title {
    max-width: 12em;
    font-size: clamp(2.6rem, 7.6vw, 5rem);
    line-height: 0.98;
    text-wrap: balance;
  }
  .hero__subtitle {
    max-width: 62ch;
    margin-top: clamp(24px, 4vw, 36px);
    font-size: clamp(1.0625rem, 1.6vw, 1.2rem);
    line-height: 1.6;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: clamp(32px, 5vw, 44px);
  }

  /* Encart « Fiche » : fiche bristol annotée */
  .fiche {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 26px 22px 10px;
    box-shadow: 4px 4px 0 var(--rule);
  }
  .fiche__label {
    position: absolute;
    top: -0.8em;
    left: 16px;
    padding: 0 8px;
    background: var(--paper);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--amber-dark);
  }
  .fiche__list {
    margin: 0;
  }
  .fiche__row {
    padding-block: 12px 14px;
  }
  .fiche__row + .fiche__row {
    border-top: var(--rule-thin);
  }
  .fiche dt {
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 1.45rem;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--ink);
  }
  .fiche dd {
    margin: 4px 0 0;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .fiche {
      max-width: 420px;
    }
  }
  @media (max-width: 480px) {
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
