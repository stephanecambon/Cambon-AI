---
import { texts, anchors, highlight, routes, type Lang } from '../i18n';
import { bookingHref } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = texts[lang].hero;
---
<section class="hero">
  <div class="container">
    <p class="eyebrow"><span class="eyebrow__num">00 /</span><span>{t.eyebrow}</span></p>
    <h1 class="hero__title" set:html={highlight(t.title)} />
    <p class="hero__subtitle">{t.subtitle}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={bookingHref}>{t.ctaPrimary}</a>
      <a class="btn btn--outline" href={`${routes.home[lang]}#${anchors[lang].projects}`}>{t.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(56px, 11vw, 136px) clamp(56px, 10vw, 120px);
  }
  .hero__title {
    max-width: 12em;
    font-size: clamp(2.6rem, 8.4vw, 5.6rem);
    line-height: 0.98;
    text-wrap: balance;
  }
  .hero__subtitle {
    max-width: 62ch;
    margin-top: clamp(24px, 4vw, 36px);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-2);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: clamp(32px, 5vw, 44px);
  }
  @media (max-width: 480px) {
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
