---
// Logo : picto + « CAMBON AI » en Barlow Condensed capitales.
import Picto from './Picto.astro';
---
<span class="logo" role="img" aria-label="Cambon AI">
  <Picto class="logo__picto" size={34} />
  <span class="logo__word" aria-hidden="true">Cambon AI</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .logo__picto {
    display: block;
    flex: none;
  }
  .logo__word {
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
</style>
