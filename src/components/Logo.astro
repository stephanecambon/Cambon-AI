---
// Logo : picto + « CAMBON » + « AI » blanc sur fond vermillon, en Barlow Condensed capitales.
import Picto from './Picto.astro';
---
<span class="logo">
  <Picto class="logo__picto" size={34} />
  <span class="logo__word" aria-hidden="true">Cambon<span class="logo__ai">AI</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .logo__picto {
    display: block;
    flex: none;
  }
  .logo__word {
    display: inline-flex;
    align-items: center;
    gap: 0.22em;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .logo__ai {
    background: var(--amber);
    color: var(--on-amber);
    padding: 0.1em 0.2em 0.06em;
    border-radius: var(--radius);
  }
</style>
