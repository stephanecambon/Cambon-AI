---
// Page « Projets » : filtres par catégorie (sans JavaScript) + cartes.
import ProjectCard from './ProjectCard.astro';
import { texts, type Lang } from '../i18n';
import { getProjets } from '../lib/projets';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = texts[lang].projects;
const projets = await getProjets(lang);
const filters = [
  { id: 'tous', label: t.filterAll },
  { id: 'difficile', label: t.categories.difficile },
  { id: 'production', label: t.categories.production },
  { id: 'saas', label: t.categories.saas },
];
---
<section class="projects-page">
  <div class="container">
    <h1>{t.title}</h1>

    <fieldset class="filters">
      <legend class="visually-hidden">{t.filterLegend}</legend>
      {filters.map((f, i) => (
        <>
          <input class="filters__input visually-hidden" type="radio" name="categorie" id={`f-${f.id}`} value={f.id} checked={i === 0} />
          <label class="filters__label" for={`f-${f.id}`}>{f.label}</label>
        </>
      ))}
    </fieldset>

    <ul class="cards">
      {projets.map((p) => <ProjectCard lang={lang} projet={p} level={2} />)}
    </ul>
  </div>
</section>

<style>
  .projects-page {
    padding-block: clamp(48px, 9vw, 96px) clamp(56px, 9vw, 104px);
  }
  .projects-page h1 {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: clamp(28px, 5vw, 40px) 0 clamp(36px, 6vw, 56px);
    padding: 0;
    border: 0;
  }
  .filters__label {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.4em 0.95em;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--ink);
    cursor: pointer;
    user-select: none;
  }
  .filters__label:hover {
    background: rgba(14, 46, 85, 0.06);
  }
  .filters__input:checked + .filters__label {
    background: var(--ink);
    color: var(--paper);
  }
  .filters__input:focus-visible + .filters__label {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  /* Filtrage en CSS pur : sans :has() (ou sans CSS), tous les projets restent visibles */
  .projects-page:has(#f-difficile:checked) :global(.card:not([data-category='difficile'])),
  .projects-page:has(#f-production:checked) :global(.card:not([data-category='production'])),
  .projects-page:has(#f-saas:checked) :global(.card:not([data-category='saas'])) {
    display: none;
  }
</style>
