      const v=c-a; h+=`<div class="yr"><div class="lab"><span>${names[n]}</span><b>${fr(v,v>=10?0:1)} ${EN?(v==1?'year':'years'):'an'+(v>=2?'s':'')}</b><small>${tx('logiciel '+fmtX(Math.pow(3,v))+" sur l'année",'software '+fmtX(Math.pow(3,v))+' over the year')}</small><small><b style="font:inherit;color:var(--sig)">${fmtX(Math.exp(GH*c))} ${tx('depuis oct. 2026','since Oct. 2026')}</b></small></div>${cubes(v)}</div>`; }
