@media (max-width:640px){.pr .dials{grid-template-columns:1fr}}
.pr .dial{display:flex;flex-direction:column;gap:8px}
@supports (grid-template-rows:subgrid){.pr .dials{row-gap:0}.pr .dial{display:grid;grid-row:span 6;grid-template-rows:subgrid;row-gap:8px}}
.pr .dial .sym{font:500 34px/1 var(--f-math);font-style:italic;color:var(--sig)}
.pr .dial h3{font-size:17px}
.pr .dial p{font-size:16px;line-height:1.45}
.pr .result{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 18px;background:var(--peach);border-radius:4px;padding:14px 18px}
.pr .result .big{font:500 40px/1 var(--f-math);font-style:italic;color:var(--sig)}
