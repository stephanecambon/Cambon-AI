/* Mobile : onglets sur toute la largeur, chacun sur une ou deux lignes, zones tactiles de 44 px */
@media (max-width:520px){.pr .seg{display:flex;flex-wrap:nowrap;align-self:stretch;border-radius:14px}.pr .seg button{flex:1 1 0;min-height:44px;padding:6px 8px;font-size:14px;line-height:1.2;border-radius:10px}.pr .chips button{min-height:44px}}
.pr .chips{display:flex;flex-wrap:wrap;gap:8px}
