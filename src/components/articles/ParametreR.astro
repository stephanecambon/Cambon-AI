    if(N) h+=txt(l,14,tx(`1er doublement : ${fr(D1,1)} mois`,`1st doubling: ${fr(D1,1)} months`),{s:13,c:mut})+txt(l,32,tx(`chaque suivant : ${fr(q*100,0)} % du précédent`,`each next one: ${fr(q*100,0)}% of the previous`),{s:13,c:mut});
    else h+=txt(l,14,tx(`1er doublement : ${fr(D1,1)} mois · chaque suivant : ${fr(q*100,0)} % du précédent`,`1st doubling: ${fr(D1,1)} months · each next one: ${fr(q*100,0)}% of the previous`),{s:13,c:mut});
