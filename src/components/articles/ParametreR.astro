  const ink=css('--ink'), mut=css('--muted'), sig=css('--sig'), acc=css('--accent'), grid=css('--grid'), peach=css('--peach');
  const rows=[
    ['g','Mesures directes, autres domaines'],
    ['Économie américaine','Bloom et al. 2020',0.32,null,null],
    ['Échecs (Stockfish)','Epoch 2024 · ± 1 écart-type',0.83,0.68,0.98],
    ['Vision par ordinateur','Epoch 2024 · un seul point',1.4,null,null],
    ['g','Estimations pour les modèles de langage (raisonnées)'],
