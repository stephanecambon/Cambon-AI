  else st=tx(`Avec r = 1, le rythme de 1,9 an par an se maintient : 9,5 années de progrès d'ici 2031, soit un logiciel ${m5} plus efficace.`,`With r = 1, the pace of 1.9 years per year holds: 9.5 years of progress by 2031, i.e. software ${m5} more efficient.`);
  $('stat').textContent=st;
