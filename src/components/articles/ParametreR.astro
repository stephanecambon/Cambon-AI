function cubes(v){ const MAX=1200, ref=K0; let h='<div class="cubes">';
  const n=Math.min(v,MAX), full=Math.floor(n);
  for(let i=0;i<full;i++) h+= i<ref?'<i class="ref"></i>':'<i></i>';
  if(n-full>0.15) h+= full<ref?'<i class="ref part"></i>':'<i class="part"></i>';
  if(v<ref){ const ghosts=Math.ceil(ref)-Math.ceil(v); for(let i=0;i<ghosts;i++) h+='<i class="ghost"></i>'; }
  if(v>MAX) h+=`<span class="over">+${Math.round(v-MAX).toLocaleString('fr-FR')} cubes de plus</span>`;
  return h+'</div>'; }

function renderProj(){
  const r=+$('rP').value, b=useDial?beta():0.25, ts=tStar(r,b);
  $('rPO').textContent=fr(r,2);
  document.querySelectorAll('#proj .chips button').forEach(bt=>bt.setAttribute('aria-pressed', bt.dataset.r==='dial'?useDial: (!useDial && Math.abs(+bt.dataset.r-r)<0.005)));
  document.querySelectorAll('#viewSeg button').forEach(bt=>bt.setAttribute('aria-pressed',bt.dataset.v===view));
  document.querySelectorAll('#unitSeg button').forEach(bt=>bt.setAttribute('aria-pressed',bt.dataset.u===unit));
  $('vCal').hidden=view!=='cal'; $('vCurve').hidden=view!=='curve'; $('vLap').hidden=view!=='lap'; $('unitSeg').hidden=view!=='curve';
  const p5=P(5,r,b), m5=fmtX(Math.exp(GH*p5));
  let st;
  if(ts<5) st=`Avec r = ${fr(r,2)}, le modèle explose vers ${dateAt(ts)}.`;
  else if(r>1.005) st=`Avec r = ${fr(r,2)}, ${fr(p5,0)} années de progrès d'ici 2031 (logiciel ${m5}), et une explosion du modèle vers ${dateAt(ts)}.`;
  else if(r<0.995) st=`Avec r = ${fr(r,2)}, l'accélération s'éteint : ${fr(p5,0)} années de progrès d'ici 2031 (logiciel ${m5}).`;
  else st=`Avec r = 1, le rythme de 1,9 an par an se maintient : 9,5 années de progrès d'ici 2031, soit un logiciel ${m5} plus efficace.`;
  $('stat').textContent=st;
  const acc=css('--accent'), sig=css('--sig'), mut=css('--muted'), grid=css('--grid'), line=css('--line');

  // Calendrier : tous les cubes
  { let h='', done=false; const names=['oct. 2026 → 2027','oct. 2027 → 2028','oct. 2028 → 2029','oct. 2029 → 2030','oct. 2030 → 2031'];
    for(let n=0;n<5;n++){ const a=P(n,r,b), c=P(n+1,r,b);
      if(!isFinite(c)){ if(!done){ h+=`<div class="yr"><div class="lab"><span>${names[n]}</span><b>∞</b></div><span class="boom">Le nombre de cubes devient infini vers ${dateAt(ts)} : c'est la signature d'une croissance hyperbolique (voir section 02). Dans la réalité, un goulot (machines, énergie, données) arrêterait la course avant.</span></div>`; done=true; } continue; }
      const v=c-a; h+=`<div class="yr"><div class="lab"><span>${names[n]}</span><b>${fr(v,v>=10?0:1)} an${v>=2?'s':''}</b><small>logiciel ${fmtX(Math.pow(3,v))} sur l'année</small><small><b style="font:inherit;color:var(--sig)">${fmtX(Math.exp(GH*c))} depuis oct. 2026</b></small></div>${cubes(v)}</div>`; }
    $('calB').innerHTML=h; }

  // Courbe
  { const isX=unit==='x', V=(t,rr)=>{const p=P(t,rr,b); return isX?Math.exp(GH*p):p;}, yMax=isX?40000:40, L=isX?84:56;
    const W=760,H=360,R=24,T=20,B=48, X=t=>L+t/5*(W-L-R), Y=v=>T+(1-Math.min(v,yMax)/yMax)*(H-T-B);
    let h='';
    (isX?[0,10000,20000,30000,40000]:[0,10,20,30,40]).forEach(v=>{h+=`<line x1="${L}" x2="${W-R}" y1="${Y(v)}" y2="${Y(v)}" stroke="${grid}"/>`+txt(L-8,Y(v)+4,isX?(v?'×'+v.toLocaleString('fr-FR'):'×1'):v,{a:'end',f:MONO,c:mut});});
    for(let y=0;y<=5;y++) h+=txt(X(y),H-22,'oct. '+(2026+y),{a:y===5?'end':y===0?'start':'middle',f:MONO,c:mut});
    h+=txt(L,H-4,isX?'efficacité du logiciel (× oct. 2026)':'années de progrès cumulées',{c:mut,s:13});
    $('capC').textContent= isX ? "Efficacité du logiciel par rapport à octobre 2026, échelle linéaire : l'exponentielle (r = 1) devient visible. Au-delà de ×40 000, la courbe sort du cadre." : "Progrès cumulé depuis octobre 2026, en années de progrès au rythme d'avant : l'échelle des scores, logarithmique. Au-delà de 40, la courbe sort du cadre.";
    const path=rr=>{ let d='',on=false; for(let i=0;i<=400;i++){ const t=5*i/400, v=V(t,rr); if(!isFinite(v)||v>yMax*1.02){ if(on) d+=`L${X(t).toFixed(1)},${Y(yMax).toFixed(1)}`; break;} d+=(on?'L':'M')+X(t).toFixed(1)+','+Y(v).toFixed(1); on=true; } return d; };
    h+=`<path d="${path(0.6)}" fill="none" stroke="${line}" stroke-width="2" stroke-dasharray="5 5"/><path d="${path(1)}" fill="none" stroke="${sig}" stroke-width="2"/>`;
    h+=txt(X(5)-4,Y(V(5,1))-8,'r = 1',{a:'end',w:700,s:13,c:sig})+txt(X(5)-4,Math.min(Y(V(5,0.6))+18,H-B-6),'r = 0,6',{a:'end',s:13,c:mut});
    h+=`<path d="${path(r)}" fill="none" stroke="${acc}" stroke-width="4"/>`;
    if(ts<5) h+=`<line x1="${X(ts)}" x2="${X(ts)}" y1="${T}" y2="${H-B}" stroke="${acc}" stroke-dasharray="4 4"/>`+txt(X(ts)+(ts>3.5?-6:6),T+14,'explosion · '+dateAt(ts),{a:ts>3.5?'end':'start',w:700,s:13,c:acc});
    $('svgC').innerHTML=h; }

  // Tours de boucle
  { const W=760,l=8,rr=8, span=96, sc=(W-l-rr)/span, p=b*(r-1), q=Math.pow(2,-p), D1=12*Math.LN2/G0;
    let h='', x=l, t=0, k=0;
    while(t<span && k<80){ const d=D1*Math.pow(q,k), w=Math.min(d,span-t)*sc;
      h+=`<rect x="${x.toFixed(2)}" y="24" width="${Math.max(w-1.5,0.6).toFixed(2)}" height="46" fill="${k%2?sig:acc}" opacity="${k%2?0.75:1}"/>`;
      if(w>34) h+=txt((x+w/2).toFixed(1),52,'×2',{a:'middle',f:MONO,s:12,w:600,c:css('--bg')});
      x+=d*sc; t+=d; k++; if(d<0.03) break; }
    if(t<span && isFinite(ts)) h+=txt(Math.min(x+8,W-150),52,'∞ vers '+dateAt(ts),{s:14,w:700,c:acc});
    for(let y=0;y<=8;y+=2){ const xx=l+y*12*sc; h+=`<line x1="${xx}" x2="${xx}" y1="80" y2="88" stroke="${mut}"/>`+txt(xx,106,y===0?'oct. 2026':'+'+y+' ans',{a:y===0?'start':y===8?'end':'middle',f:MONO,c:mut}); }
    h+=txt(l,14,`1er doublement : ${fr(D1,1)} mois · chaque suivant : ${fr(q*100,0)} % du précédent`,{s:13,c:mut});
    $('svgL').innerHTML=h; }
}

