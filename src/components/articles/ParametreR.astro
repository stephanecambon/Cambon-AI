.pr,.pr *,.pr *::before,.pr *::after{box-sizing:border-box}.pr img{max-width:100%}
/* Neutralise les styles de titres du site (capitales, interlettrage) */
.pr h1,.pr h2,.pr h3{text-transform:none;letter-spacing:normal}
/* Layout : article long en une colonne (68ch), ponctué de modules interactifs pleine largeur sur fond blanc ; charte Cambon AI */
.pr{
  --bg:#FFFBF7; --surface:#FFFFFF; --ink:#4A190F; --sig:#782114; --accent:#E02A00;
  --muted:#A54631; --line:#EBA18B; --grid:#F6E2D8; --peach:#FFD2BA; --on-accent:#FFFFFF;
  --f-bg:#4A190F; --f-fg:#FFFBF7; --f-mut:#EBA18B; --f-grid:#6E3122; --f-a:#FF6A3D; --f-b:#FFD2BA;
  --f-display:"Bricolage Grotesque",system-ui,sans-serif;
  --f-body:"Source Sans 3",system-ui,sans-serif;
  --f-mono:"JetBrains Mono",ui-monospace,monospace;
  --f-math:"Newsreader","Times New Roman",serif;
}
.pr{background:var(--bg);color:var(--ink);font:18px/1.6 var(--f-body);
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:32px 72px}
.pr [hidden]{display:none!important}
.pr .wrap{max-width:920px;margin:0 auto;display:flex;flex-direction:column;gap:64px}
.pr .col{max-width:68ch;display:flex;flex-direction:column;gap:16px}
.pr p{margin:0}
.pr .brand{display:flex;align-items:center;gap:10px;font:800 16px/1 var(--f-display);color:var(--sig);letter-spacing:.02em}
.pr .brand svg{width:30px;height:30px;flex:none}
.pr .brand .ai{background:var(--accent);color:var(--on-accent);padding:3px 6px;border-radius:2px;font-size:13px}
.pr .kicker{font:600 13px/1 var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.pr h1{font:800 clamp(40px,8vw,76px)/1 var(--f-display);color:var(--sig);margin:0;letter-spacing:-.02em;text-wrap:balance}
.pr h1 em{font-family:var(--f-math);font-style:italic;font-weight:500;color:var(--accent)}
.pr h2{font:800 clamp(26px,4vw,34px)/1.15 var(--f-display);color:var(--sig);margin:0;text-wrap:balance}
.pr h3{font:700 19px/1.3 var(--f-body);margin:0;color:var(--sig)}
.pr .num{font:600 13px/1 var(--f-mono);color:var(--muted)}
.pr .lede{font-size:21px;line-height:1.5}
.pr .m{font-family:var(--f-math);font-style:italic;font-size:1.12em;white-space:nowrap;color:var(--accent)}
.pr .focus .m{color:var(--f-a)}
.pr b.gk{font-weight:700}
.pr hr{border:0;border-top:1px solid var(--line);margin:6px 0;width:100%}
.pr .avis-head{display:flex;flex-wrap:wrap;align-items:center;gap:12px 22px}
.pr .human{display:inline-flex;align-items:center;gap:10px;border:2.5px solid var(--accent);color:var(--accent);border-radius:6px;padding:6px 14px 6px 10px;transform:rotate(-3deg);font-family:Caveat,"Source Sans 3",cursive}
.pr .human svg{width:26px;height:26px;flex:none}
.pr .human b{display:block;font:700 26px/1 Caveat,"Source Sans 3",cursive}
.pr .human small{display:block;font:600 11px/1.3 var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--sig)}
.pr mark{background:var(--peach);color:inherit;padding:0 3px;border-radius:2px}
.pr .hero{display:flex;flex-direction:column;gap:20px}
/* Crayonné « Flemme de tout lire » sous l'accroche */
.pr .flemme{align-self:flex-start;display:inline-flex;flex-wrap:wrap;align-items:center;gap:4px 12px;margin-top:4px;transform:rotate(-2deg);transform-origin:left center;font:700 28px/1.15 Caveat,"Source Sans 3",cursive;color:var(--sig);text-decoration:none}
.pr .flemme__fleche{width:56px;height:26px;flex:none;color:var(--accent)}
.pr .flemme__b{display:inline-flex;align-items:center;gap:6px;color:var(--accent);background:linear-gradient(transparent 62%,rgba(224,42,0,.18) 62%,rgba(224,42,0,.18) 92%,transparent 92%);padding:0 4px}
.pr .flemme__play{width:22px;height:22px;flex:none}
.pr .flemme:hover .flemme__b,.pr .flemme:focus-visible .flemme__b{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:4px}
.pr .flemme:focus-visible{outline:2px solid var(--accent);outline-offset:4px;border-radius:4px}
/* Easter egg « singularité » : le mot garde l'allure du texte, seul le survol le trahit */
.pr a.oeuf{color:inherit;text-decoration:none;cursor:pointer}
.pr a.oeuf:hover{text-decoration:underline dotted var(--accent);text-decoration-thickness:2px;text-underline-offset:4px}
.pr a.oeuf:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:2px}
.pr .oeuf-dlg{padding:0;border:0;background:transparent;max-width:min(92vw,86vh);overflow:visible}
.pr .oeuf-dlg::backdrop{background:rgba(10,14,28,.82)}
.pr .oeuf-dlg img{display:block;width:100%;height:auto;border-radius:6px;box-shadow:0 20px 60px rgba(0,0,0,.5)}
.pr .oeuf-dlg form{position:absolute;top:-14px;right:-14px;margin:0}
.pr .oeuf-dlg__x{width:44px;height:44px;border-radius:50%;border:0;background:var(--surface);color:var(--sig);font:600 28px/1 var(--f-body);cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.3)}
.pr .oeuf-dlg__x:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
@media (max-width:560px){.pr .oeuf-dlg form{top:-52px;right:0}}
/* Abonnement à la veille (section 06) */
.pr .veille{display:flex;flex-direction:column;align-items:center;gap:14px;text-align:center;padding:8px 0 4px}
.pr .veille__mot{display:flex;align-items:flex-end;gap:6px;margin:0;transform:rotate(-2deg);font:700 28px/1.15 Caveat,"Source Sans 3",cursive;color:var(--accent)}
.pr .veille__fleche{width:30px;height:40px;flex:none;color:var(--accent);margin-bottom:-18px}
@media (max-width:560px){.pr .veille__mot{font-size:22px}}
.pr .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
@media (max-width:560px){.pr .flemme{font-size:25px}.pr .flemme__fleche{width:44px}}
.pr .module{background:var(--surface);border:0;border-radius:6px;padding:24px;display:flex;flex-direction:column;gap:18px}
@media (max-width:560px){.pr .module{padding:18px 14px}.pr{font-size:17px}}
.pr .def{font-size:20px;line-height:1.5;background:var(--surface);border-left:4px solid var(--accent);border-radius:4px;padding:18px 22px}
.pr .small{font-size:15px;color:var(--muted)}
.pr svg{display:block;width:100%;height:auto}
.pr .seg{display:inline-flex;flex-wrap:wrap;gap:4px;border:1px solid var(--line);border-radius:999px;padding:4px;align-self:flex-start}
.pr .seg button{font:600 15px var(--f-body);border:0;background:transparent;color:var(--muted);padding:7px 16px;border-radius:999px;cursor:pointer}
.pr .seg button[aria-pressed=true]{background:var(--sig);color:var(--bg)}
.pr .chips{display:flex;flex-wrap:wrap;gap:8px}
.pr .chips button{font:600 14px var(--f-body);border:1px solid var(--line);background:var(--bg);color:var(--ink);padding:6px 12px;border-radius:4px;cursor:pointer}
.pr .chips button[aria-pressed=true]{border-color:var(--accent);background:var(--accent);color:var(--on-accent)}
.pr button:focus-visible,.pr input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
