      if(tm>=3) s+=`<circle cx="${f.X(3)}" cy="${f.Y(3.9)}" r="12" fill="none" stroke="${fg}" stroke-width="2.5"/>`+txt(f.X(3)+16,f.Y(3.9)+30,'on est là',{f:'Caveat',s:22,w:700,c:fg});
      return s; };
    h+=`<clipPath id="clipE"><rect x="${r.L-10}" y="${r.T-14}" width="${r.R-r.L+20}" height="${r.B-r.T+14}"/></clipPath>`;
    h+=draw(l,M)+`<g clip-path="url(#clipE)">`+draw(Object.assign({},r,{Y:v=>r.B-v/8*(r.B-r.T)}),E)+'</g>';
    if(tm>=2) h+=txt(l.X(2)-16,l.Y(2)-14,'la cassure',{a:'end',f:'Caveat',s:22,w:700,c:a})+txt(r.X(2)-16,r.Y(2)-14,'la cassure',{a:'end',f:'Caveat',s:22,w:700,c:a});
    if(p>=1){ h+=txt(l.X(4.3),l.Y(6.8)-14,'même pente',{a:'end',s:12,c:m})+txt(r.X(4.15)-8,r.T+12,'sort du cadre ↑',{a:'end',f:'Caveat',s:22,w:700,c:a})+txt(r.X(3.85),r.Y(5.6),'chaque année plus raide',{a:'end',s:12,c:m}); }
    return h; }},
 {t:"L'escalier se redresse jusqu'à la verticale", x:"Si les cassures se répètent, elles se rapprochent, et chaque marche est plus raide que la précédente. La ligne se courbe, puis devient verticale : la courbe atteint l'infini à une date précise. C'est une croissance hyperbolique.",
  d:p=>{ const a=css('--f-a'), b2=css('--f-b'), m=css('--f-mut'), fg=css('--f-fg');
    const f=frame(0,FW,[2024,2032.5],[120,520],{yt:[[150,'150'],[250,'250'],[350,'350'],[450,'450']],xt:[[2024,'2024'],[2026,'2026'],[2028,'2028'],[2030,'2030'],[2032,'2032']],ylab:'AECI'});
    const ts=TE0+tStar(1.4,0.25), st=stairs(1.4,0.25,2032.5,24,520), tm=2024.15+(2032.5-2024.15)*p; let h=f.h;
    h+=pl(hist.slice(0,2),tm,f.X,f.Y,b2,4)+pl(hist.slice(1),tm,f.X,f.Y,a,4)+pl(st,tm,f.X,f.Y,a,4);
    st.forEach(([t,v])=>{ if(t<=tm) h+=`<circle cx="${f.X(t)}" cy="${f.Y(v)}" r="3" fill="${fg}"/>`; });
    if(p>=1){ h+=`<line x1="${f.X(ts)}" x2="${f.X(ts)}" y1="${f.T}" y2="${f.B}" stroke="${m}" stroke-dasharray="5 5"/>`+txt(f.X(ts)-8,f.B-14,'l\'infini, vers '+dateAt(ts-TE0+ (TE0-(2026+279/365))),{a:'end',s:14,w:700,c:a}); }
    return h; }},
 {t:"Comment s'appelle ce paramètre qui contrôle la courbe ?", x:"Il s'appelle r, le rendement de la R&D logicielle. En dessous de 1, la courbe s'aplatit. À 1, elle reste droite. Au-dessus de 1, elle se courbe jusqu'à la verticale. Essayez.", reveal:true,
  d:p=>{ const a=css('--f-a'), b2=css('--f-b'), m=css('--f-mut'); const r=+$('rF').value; $('rFO').textContent=fr(r,2);
    const f=frame(0,FW,[2024,2032],[120,400],yAECI); let h=f.h;
    h+=pl(hist.slice(0,2),9999,f.X,f.Y,b2,4)+pl(hist.slice(1),9999,f.X,f.Y,a,4);
    if(p<0.55) return h;
    h+=pl(smooth(1,0.25,2032,400),9999,f.X,f.Y,m,2,true)+txt(f.X(2031.5),f.Y(A0F+15*P(2031.5-TE0,1,0.25))+20,'r = 1',{a:'end',s:13,c:m});
    const sm=smooth(r,0.25,2032,400); h+=pl(sm,9999,f.X,f.Y,a,4.5);
    const ts=TE0+tStar(r,0.25); if(ts<2032) h+=`<line x1="${f.X(ts)}" x2="${f.X(ts)}" y1="${f.T}" y2="${f.B}" stroke="${a}" stroke-dasharray="4 4"/>`;
    return h; }}
];
SLIDES.splice(4,1); // étape « L'escalier se redresse » retirée
SLIDES.splice(2,1); // étape « La cassure : l'exponentielle change de vitesse » retirée
let fCur=0, fRaf=0;
const reduce=()=>{ try{ return matchMedia('(prefers-reduced-motion: reduce)').matches; }catch(e){ return false; } };
function fDraw(p){ const s=SLIDES[fCur]; $('svgF').innerHTML=s.d(p); if(s.reveal){ const on=p>=0.55; $('fReveal').hidden=!on; $('fCtl').hidden=!on; $('fText').hidden=!on;
    // le « r » apparaît au centre, puis se range en haut à gauche du graphique et y reste
    const pop=Math.min(1,Math.max(0,(p-0.55)/0.15)), k=Math.min(1,Math.max(0,(p-0.8)/0.2)), e=1-Math.pow(1-k,3);
    const sp=$('fReveal').querySelector('span'); sp.style.left=`calc(50% - ${e}*(50% - 120px))`; sp.style.top=`calc(50% - ${e}*(50% - 70px))`;
    sp.style.transform=`translate(-50%,-50%) scale(${(0.6+0.4*pop)*(1-0.55*e)})`; } }
function fPlay(){ cancelAnimationFrame(fRaf); if(reduce()){ fDraw(1); return; } const t0=performance.now(), dur=SLIDES[fCur].reveal?3000:2600;
  const step=now=>{ const p=Math.min(1,(now-t0)/dur); fDraw(p); if(p<1) fRaf=requestAnimationFrame(step); }; fRaf=requestAnimationFrame(step); }
function fShow(i){ fCur=Math.max(0,Math.min(SLIDES.length-1,i)); const s=SLIDES[fCur];
  $('fStep').textContent=`Étape ${fCur+1} sur ${SLIDES.length}`; $('fTitle').textContent=s.t; $('fText').textContent=s.x; $('fText').hidden=!!s.reveal; $('fCtl').hidden=true; $('fReveal').hidden=true;
  $('fPrev').disabled=fCur===0; $('fNext').disabled=fCur===SLIDES.length-1;
  document.querySelectorAll('#fDots button').forEach((b,k)=>b.setAttribute('aria-current',k===fCur)); fPlay(); }
$('fDots').innerHTML=SLIDES.map((s,k)=>`<button type="button" aria-label="Étape ${k+1} : ${s.t.replace(/"/g,'')}"></button>`).join('');
document.querySelectorAll('#fDots button').forEach((b,k)=>b.addEventListener('click',()=>fShow(k)));
$('fPrev').addEventListener('click',()=>fShow(fCur-1)); $('fNext').addEventListener('click',()=>fShow(fCur+1)); $('fReplay').addEventListener('click',fPlay);
$('deck').addEventListener('keydown',e=>{ if(e.key==='ArrowRight'){fShow(fCur+1);e.preventDefault();} if(e.key==='ArrowLeft'){fShow(fCur-1);e.preventDefault();} });
$('rF').addEventListener('input',()=>{ cancelAnimationFrame(fRaf); fDraw(1); $('fCtl').hidden=false; $('fText').hidden=false; });
let fx0=null; $('deck').addEventListener('pointerdown',e=>{ if(e.target.closest('input,button')) return; fx0=e.clientX; }); $('deck').addEventListener('pointerup',e=>{ if(fx0==null) return; const dx=e.clientX-fx0; fx0=null; if(Math.abs(dx)>50) fShow(fCur+(dx<0?1:-1)); });

function all(){ renderMetr(); renderMini(); renderEst(); renderDial(); fDraw(1); }
fShow(0);

/* ---- Mise en forme : tous les « r » en rouge, « λ » et « β » en gras (textes et graphiques) ---- */
const WORD=/(^|[^\p{L}\d])(r|λ|β)(?![\p{L}\d'’])/gu;
function deco(root){ if(!root||!root.ownerDocument) return;
  const tw=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,{acceptNode:n=>{ const p=n.parentElement; if(!p) return 2;
    if(p.closest('script,style,input,textarea,button,.m,.gk,.reveal,h1 em,title')) return 2;
    WORD.lastIndex=0; return WORD.test(n.data)?1:2; }});
  const nodes=[]; while(tw.nextNode()) nodes.push(tw.currentNode);
  nodes.forEach(n=>{ const svgP=n.parentElement.closest('svg'), s=n.data, frag=document.createDocumentFragment(); let last=0, m; WORD.lastIndex=0;
    while((m=WORD.exec(s))){ const st=m.index+m[1].length, w=m[2]; frag.append(s.slice(last,st)); let el;
      if(svgP){ el=document.createElementNS('http://www.w3.org/2000/svg','tspan'); el.setAttribute('class','gk'); el.setAttribute('font-weight','700'); if(w==='r') el.setAttribute('fill', n.parentElement.closest('.focus')?css('--f-a'):css('--accent')); }
      else { el=document.createElement(w==='r'?'span':'b'); el.className=w==='r'?'m':'gk'; }
      el.textContent=w; frag.append(el); last=st+w.length; WORD.lastIndex=last; }
    frag.append(s.slice(last)); n.replaceWith(frag); }); }
const MO=new MutationObserver(ms=>{ MO.disconnect(); const seen=new Set(); ms.forEach(m=>{ const t=m.type==='characterData'?m.target.parentNode:m.target; if(t&&!seen.has(t)){ seen.add(t); deco(t); } }); MO.observe(document.querySelector('.wrap'),{childList:true,subtree:true,characterData:true}); });
/* ---- Info-bulle des points du graphique 01 (survol à la souris, toucher sur mobile) ---- */
(function(){
  const svg=$('svgMetr'), tip=document.createElement('div');
  tip.className='pr-tip'; tip.hidden=true; tip.setAttribute('role','tooltip'); document.querySelector('.pr').appendChild(tip);
  const show=(g,x,y)=>{ tip.textContent=g.dataset.tip; tip.hidden=false;
    const w=tip.offsetWidth, left=Math.min(Math.max(8,x-w/2),innerWidth-w-8); tip.style.left=left+'px'; tip.style.top=(y-44)+'px'; };
  const hide=()=>{ tip.hidden=true; };
  svg.addEventListener('pointermove',e=>{ if(e.pointerType==='touch') return; const g=e.target.closest('g.pt'); g?show(g,e.clientX,e.clientY):hide(); });
  svg.addEventListener('pointerleave',e=>{ if(e.pointerType!=='touch') hide(); });
  svg.addEventListener('click',e=>{ const g=e.target.closest('g.pt'); if(g){ const r=g.querySelector('circle').getBoundingClientRect(); show(g,r.left+r.width/2,r.top+r.height/2); } else hide(); });
  addEventListener('scroll',hide,{passive:true});
})();
all();
deco(document.querySelector('.wrap'));
// Easter egg : ouvre la citation par-dessus la page (sans JS, le lien ouvre l'image)
try{ const dlg=document.getElementById('oeufDlg'), egg=document.querySelector('.pr a.oeuf');
  if(dlg && egg && dlg.showModal){ egg.addEventListener('click',e=>{ e.preventDefault(); dlg.showModal(); });
    dlg.addEventListener('click',e=>{ if(e.target===dlg) dlg.close(); }); } }catch(e){}
MO.observe(document.querySelector('.wrap'),{childList:true,subtree:true,characterData:true});
})();
