      for(let n=1;n<=Math.floor(tm+1e-9);n++){ const c=n<=2?b2:a, fut=n>3, v=V[n]; s+=`<circle cx="${f.X(n)}" cy="${f.Y(v)}" r="6" fill="${fut?fbg:c}" stroke="${c}" stroke-width="2.5"/>`; }
