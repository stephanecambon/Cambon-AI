.pr .ftext p{font-size:18px;line-height:1.55;max-width:66ch}
.pr .focus .ctl label{color:var(--f-mut)} .pr .focus .ctl output{color:var(--f-fg)}
.pr .focus input[type=range]{accent-color:var(--f-a)}
.pr .fnav{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.pr .fnav button{font:600 15px var(--f-body);border:1px solid var(--f-grid);background:transparent;color:var(--f-fg);padding:8px 14px;border-radius:4px;cursor:pointer}
.pr .fnav button.primary{background:var(--f-a);border-color:var(--f-a);color:var(--f-bg)}
.pr .fnav button:disabled{opacity:.35;cursor:default}
.pr .fnav button:focus-visible{outline:2px solid var(--f-a);outline-offset:2px}
.pr .dots{display:flex;gap:6px;flex:1;justify-content:center}
.pr .dots button{width:10px;height:10px;padding:0;border-radius:50%;border:1px solid var(--f-mut);background:transparent}
.pr .dots button[aria-current=true]{background:var(--f-a);border-color:var(--f-a)}
.pr .pr-tip{position:fixed;z-index:30;pointer-events:none;background:var(--sig);color:#fff;font:600 14px/1.3 var(--f-body);padding:6px 10px;border-radius:4px;white-space:nowrap;box-shadow:0 4px 14px rgba(74,25,15,.25)}
.pr #svgMetr g.pt{cursor:pointer}
.pr .fnote{font-size:14px;color:var(--f-mut);margin:0}
</style>

<script is:inline>
(function(){
const $=id=>document.getElementById(id);
// Langue de la page (data-lang sur .pr) : libellés et nombres en français ou en anglais
const EN=document.querySelector('.pr').dataset.lang==='en', LOC=EN?'en-US':'fr-FR', tx=(f,e)=>EN?e:f;
const fr=(x,d=1)=>x.toLocaleString(LOC,{minimumFractionDigits:d,maximumFractionDigits:d});
const css=n=>getComputedStyle(document.querySelector('.pr')).getPropertyValue(n).trim();
const GH=Math.log(3), K0=1.9, G0=K0*GH;  // ×3/an par année de progrès ; accélération METR
const MONO='JetBrains Mono, ui-monospace, monospace', BODY='Source Sans 3, system-ui, sans-serif';
const beta=()=>+$('bet').value;
function P(t,r,b){ const p=b*(r-1); if(Math.abs(p)<1e-9) return K0*t; const q=1-p*G0*t; if(q<=0) return Infinity; return -Math.log(q)/(p*GH); }
function tStar(r,b){ const p=b*(r-1); return p>1e-9?1/(p*G0):Infinity; }
function dateAt(t){ const y=2026+279/365+t, yr=Math.floor(y), m=Math.floor((y-yr)*12); return (EN?['Jan.','Feb.','Mar.','Apr.','May','Jun.','Jul.','Aug.','Sep.','Oct.','Nov.','Dec.']:['janv.','févr.','mars','avr.','mai','juin','juil.','août','sept.','oct.','nov.','déc.'])[m]+' '+yr; }
function fmtX(m){ if(!isFinite(m)) return '∞'; if(m<10) return '×'+fr(m,1); if(m<1000) return '×'+Math.round(m);
  if(m<1e6) return '×'+Number(m.toPrecision(2)).toLocaleString(LOC);
  if(m<1e9) return '×'+fr(m/1e6,1)+' million'+(!EN&&m>=2e6?'s':''); if(m<1e12) return '×'+fr(m/1e9,1)+tx(' milliard'+(m>=2e9?'s':''),' billion'); return '×10^'+Math.floor(Math.log10(m)); }
// Mobile : sous 600 px de large, les graphiques sont redessinés plus étroits (moins réduits à l'écran)
// et leurs textes agrandis, pour rester lisibles (au moins ~11 px à l'écran).
let NARROW=false, TXS=1;
function setNarrow(){ const w=document.querySelector('.pr .wrap').clientWidth; NARROW=w<600; TXS=NARROW?1.15:1; }
const vb=(s,W,H)=>s.setAttribute('viewBox',`0 0 ${W} ${H}`);
const txt=(x,y,s,o={})=>`<text x="${x}" y="${y}" text-anchor="${o.a||'start'}" font-family="${o.f||BODY}" font-size="${((o.s||12)*TXS).toFixed(1)}" font-weight="${o.w||400}" fill="${o.c}">${s}</text>`;
const vtxt=(x,y,s,o={})=>`<text transform="translate(${x},${y}) rotate(-90)" text-anchor="middle" font-family="${o.f||BODY}" font-size="${((o.s||12)*TXS).toFixed(1)}" font-weight="${o.w||700}" fill="${o.c}">${s}</text>`;

/* ---- 01 Courbe METR (schéma) ---- */
let metrMode='trend';
document.querySelectorAll('#metrSeg button').forEach(b=>b.addEventListener('click',()=>{metrMode=b.dataset.m; renderMetr();}));
// Scores relevés sur le graphique METR : [nom, date (année décimale), AECI, interne, meilleur du moment, étiquette]
const MODELS=[['Claude 3 Opus',2024.15,124.7,0,1,1],['Claude 3.5 Sonnet',2024.45,130.0,0,1,1],[tx('Claude 3.5 Sonnet (nouveau)','Claude 3.5 Sonnet (new)'),2024.77,133.2,0,1,0],['Claude 3.7 Sonnet',2025.13,141.7,0,1,1],['Claude Opus 4',2025.38,144.8,0,1,1],['Claude Sonnet 4.5',2025.73,147.8,0,1,1],['Claude Opus 4.5',2025.89,152.3,0,1,0],['Claude Opus 4.6',2026.07,157.3,0,1,1],[tx('Mythos Preview (version précoce)','Mythos Preview (early version)'),2026.15,162.4,1,1,0],['Mythos Preview',2026.25,165.7,1,1,1],['Opus 4.7',2026.28,160.3,0,0,0],['Opus 4.8',2026.38,163.5,0,0,0],['Mythos 5',2026.42,168.7,0,1,1],[tx('Model 2 (version précoce)','Model 2 (early version)'),2026.53,171.8,1,1,0],['Opus 5',2026.55,169.3,0,0,0],['Model 2',2026.60,174.1,1,1,0],['Mythos 5.1',2026.60,172.5,0,0,0],[tx('Model 3 (version précoce)','Model 3 (early version)'),2026.69,176.3,1,1,0],['Opus 5.5',2026.69,174.6,0,0,0],['Model 3',2026.73,177.0,1,1,0],['Model 4',2026.74,178.6,1,1,0]];
function renderMetr(){
  const N=NARROW, s=$('svgMetr'), W=N?400:760,H=360,L=N?50:74,R=N?100:120,T=N?30:24,B=46, t0=2024.0, t1=2026.85, yLo=120, yHi=190, TB=2025+279/365, TE=2026.74;
  vb(s,W,H);
  const X=t=>L+(t-t0)/(t1-t0)*(W-L-R), Y=v=>T+(yHi-v)/(yHi-yLo)*(H-T-B);
  const sig=css('--sig'), acc=css('--accent'), mut=css('--muted'), grid=css('--grid'), line=css('--line'), peach=css('--peach'), bg=css('--surface');
  const AB=149.9, A=t=> t<=TB ? AB+15.4*(t-TB) : AB+29*(t-TB), C=t=>AB+15.4*(t-TB);
  const models=metrMode==='models';
  document.querySelectorAll('#metrSeg button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.m===metrMode)); $('metrLeg').hidden=!models;
  let h='';
  (N?[120,140,160,180]:[120,130,140,150,160,170,180,190]).forEach(v=>{h+=`<line x1="${L}" x2="${W-R}" y1="${Y(v)}" y2="${Y(v)}" stroke="${grid}"/>`+txt(L-8,Y(v)+4,v,{a:'end',f:MONO,c:mut});});
  (N?[['2024',2024],['2025',2025],['2026',2026]]:(EN?[['Jan. 2024',2024],['Jul. 2024',2024.5],['Jan. 2025',2025],['Jul. 2025',2025.5],['Jan. 2026',2026],['Jul. 2026',2026.5]]:[['janv. 2024',2024],['juil. 2024',2024.5],['janv. 2025',2025],['juil. 2025',2025.5],['janv. 2026',2026],['juil. 2026',2026.5]])).forEach(([d,t])=>{h+=txt(X(t),H-24,d,{a:'middle',f:MONO,c:mut});});
  h+=vtxt(N?14:18,(T+H-B)/2,N?'AECI':tx('AECI (score de capacité)','AECI (capability score)'),{s:N?13:15,c:sig});
  h+=`<polygon points="${X(TB)},${Y(AB)} ${X(TE)},${Y(A(TE))} ${X(TE)},${Y(C(TE))}" fill="${peach}" opacity=".8"/>`;
  h+=`<line x1="${X(TB)}" x2="${X(TB)}" y1="${T}" y2="${H-B}" stroke="${mut}" stroke-dasharray="4 4"/>`+txt(X(TB)-6,T+10,N?tx('rupture · oct. 2025','break · Oct. 2025'):tx('rupture · 7 oct. 2025','break · Oct. 7, 2025'),{a:'end',c:mut,s:13,w:600});
  h+=`<line x1="${X(TB)}" y1="${Y(AB)}" x2="${X(TE)}" y2="${Y(C(TE))}" stroke="${line}" stroke-width="2.5" stroke-dasharray="6 5"/>`;
  h+=`<line x1="${X(2024.15)}" y1="${Y(A(2024.15))}" x2="${X(TB)}" y2="${Y(AB)}" stroke="${sig}" stroke-width="${models?2.5:4}" stroke-linecap="round"/>`;
  h+=`<line x1="${X(TB)}" y1="${Y(AB)}" x2="${X(TE)}" y2="${Y(A(TE))}" stroke="${acc}" stroke-width="${models?2.5:4}" stroke-linecap="round"/>`;
  h+=N?(models?txt(X(TB)-8,H-B-12,tx('+15 points par an','+15 points a year'),{c:sig,s:14,w:700,a:'end'}):txt(X(2025.05),Y(A(2025.05))-14,tx('+15 points par an','+15 points a year'),{c:sig,s:14,w:700,a:'end'})):txt(X(2025.3),Y(A(2025.3))+32,tx('+15 points par an','+15 points a year'),{c:sig,s:14,w:700,a:'middle'});
  if(N){
    // mobile : fins de courbes étiquetées dans une colonne à droite (sur deux lignes),
    // pente annoncée en haut à gauche de la rupture, dans la zone vide
    h+=txt(X(TE)+8,Y(C(TE))+4,tx('sans','without'),{c:mut,s:12})+txt(X(TE)+8,Y(C(TE))+19,tx('accélération','acceleration'),{c:mut,s:12});
    if(!models) h+=txt(X(TB)-8,Y(176),tx('+29 par an (×1,9)','+29 a year (×1.9)'),{c:acc,s:14,w:700,a:'end'});
    else h+=txt(X(TB)-8,Y(178),tx('pente : +29 par an','slope: +29 a year'),{c:acc,s:13,w:700,a:'end'})+txt(X(TB)-8,Y(178)+17,tx('au lieu de +15','instead of +15'),{c:acc,s:13,w:700,a:'end'});
  } else {
    h+=txt(X(TE)+12,Y(C(TE))+4,tx('sans accélération','without acceleration'),{c:mut,s:13});
    if(!models) h+=txt(X(2026.2),Y(A(2026.2))-22,tx('+29 par an (×1,9)','+29 a year (×1.9)'),{c:acc,s:14,w:700,a:'end'});
    else h+=txt(X(TE)+12,Y(C(TE))+26,tx('pente : +29 par an','slope: +29 a year'),{c:acc,s:13,w:700})+txt(X(TE)+12,Y(C(TE))+42,tx('au lieu de +15','instead of +15'),{c:acc,s:13,w:700});
  }
  const m4=N?txt(X(TE)+10,Y(178.6)+4,'Model 4',{c:acc,s:13,w:700})+txt(X(TE)+10,Y(178.6)+20,tx('178,6','178.6'),{c:acc,s:13,w:700}):txt(X(TE)+12,Y(178.6)+4,tx('Model 4 · 178,6','Model 4 · 178.6'),{c:acc,s:14,w:700});
  if(models){
    // sur mobile, les noms des modèles s'affichent au toucher (info-bulle), pas sur le graphique
    MODELS.forEach(([n,d,v,int,fr0,lab])=>{ const c=int?acc:sig, x=X(d), y=Y(v);
      h+=`<g class="pt" data-tip="${n}${tx(' : ',': ')}${fr(v,1)}"><circle cx="${x}" cy="${y}" r="14" fill="transparent"/><circle cx="${x}" cy="${y}" r="${N?5:6}" fill="${fr0?c:bg}" stroke="${c}" stroke-width="2"/>${lab&&!N?(d>TB?txt(x-10,y+4,n.replace('Claude ',''),{a:'end',s:12,w:600,c:c}):txt(x,y-12,n.replace('Claude ',''),{a:'middle',s:12,w:600,c:c})):''}</g>`; });
    h+=m4;
  } else {
    h+=`<circle cx="${X(TE)}" cy="${Y(A(TE))}" r="6" fill="${acc}"/>`+m4;
  }
  s.innerHTML=h;
}


/* ---- 04 Composition ---- */
const verdict=r=> r>1.02?tx("La boucle s'emballe","The loop takes off"): r<0.98?tx("La boucle s'essouffle","The loop runs out of steam"):tx("Pile au seuil : exponentielle","Right at the threshold: exponential");
function dialR(){ return +$('lam').value / +$('bet').value; }
let useDial=false, view='curve', unit='x';
function renderDial(){
  $('lamO').textContent=fr(+$('lam').value,2); $('betO').textContent=fr(+$('bet').value,2);
  const lam=+$('lam').value, bt=+$('bet').value;
  $('lamL').textContent=tx(`λ = ${fr(lam,2)} : doubler le nombre de chercheurs accélère le progrès de ${fr((Math.pow(2,lam)-1)*100,0)} %.`,`λ = ${fr(lam,2)}: doubling the number of researchers speeds up progress by ${fr((Math.pow(2,lam)-1)*100,0)}%.`);
  $('betL').textContent=tx(`β = ${fr(bt,2)} : à nombre de chercheurs constant, chaque doublement du logiciel prend ${fr((Math.pow(2,bt)-1)*100,0)} % de temps de plus que le précédent.`,`β = ${fr(bt,2)}: with a constant number of researchers, each software doubling takes ${fr((Math.pow(2,bt)-1)*100,0)}% longer than the previous one.`);
  renderDialCharts(lam,bt);
  const r=dialR(); $('rRes').textContent='r = '+fr(r,2); $('rVer').textContent=verdict(r);
  if(useDial) $('rP').value=Math.min(2.5,Math.max(0.4,r));
