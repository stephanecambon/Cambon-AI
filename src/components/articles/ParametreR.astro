function smooth(r,b,tEnd,cap){ const pts=[], ts=tStar(r,b); for(let i=0;i<=800;i++){ const tau=(tEnd-TE0)*i/800; if(tau>=ts*0.999) break; const A=A0F+15*P(tau,r,b); if(cap&&A>cap) break; pts.push([TE0+tau, A]); } return pts; }
function stairs(r,b,tEnd,step,cap){ cap=cap||520; const p=b*(r-1), pts=[[TE0,A0F]]; let tau=0, A=A0F;
  for(let i=0;i<300;i++){ const k=K0/(1-p*G0*tau); if(!(k>0)) break; const dur=step/(15*k); tau+=dur; A+=step; if(TE0+tau>tEnd||A>cap) break; pts.push([TE0+tau,A]); } return pts; }
const yAECI={yt:[[150,'150'],[200,'200'],[250,'250'],[300,'300'],[350,'350']],xt:[[2024,'2024'],[2026,'2026'],[2028,'2028'],[2030,'2030'],[2032,'2032']],ylab:'AECI'};

