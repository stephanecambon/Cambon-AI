---
// Article « Tout dépend de r » (paramètre r) : page interactive, avec ses
// propres styles (isolés sous .pr), ses polices (servies depuis cambon.ai,
// public/fonts/parametre-r/) et son script (graphiques, diaporama, simulations).

// Lien de la vidéo explicative (crayonné sous l'accroche). Vide = crayonné masqué
// sur le site en ligne ; affiché en local (npm run dev) pour la mise au point.
const VIDEO_URL = '';
const montrerVideo = VIDEO_URL !== '' || import.meta.env.DEV;

// Contenu : parametre-r/Fr.astro et parametre-r/En.astro (mêmes id et classes) ;
// structure, styles et script ci-dessous, communs aux deux langues.
import Fr from './parametre-r/Fr.astro';
import En from './parametre-r/En.astro';

interface Props {
  lang?: 'fr' | 'en';
}
const { lang = 'fr' } = Astro.props;
const en = lang === 'en';

// Easter egg : la première mention de « singularité » ouvre la citation de Vernor Vinge.
import { getImage } from 'astro:assets';
import vingeSrc from '../../assets/articles/vinge-singularite.png';
const vinge = await getImage({ src: vingeSrc, format: 'webp', width: 1200, quality: 85 });
const vingeAlt = en
  ? "Quote from Vernor Vinge, “The Coming Technological Singularity”, NASA, 1993: “Within thirty years, we will have the technological means to create superhuman intelligence. Shortly after, the human era will be ended.”"
  : "Citation de Vernor Vinge, « The Coming Technological Singularity », NASA, 1993 : « D'ici trente ans, nous aurons les moyens technologiques de créer une intelligence surhumaine. Peu après, l'ère humaine prendra fin. »";
---
<div class="pr" data-lang={lang}>
<div class="wrap">
  {en ? <En videoUrl={VIDEO_URL} showVideo={montrerVideo} vingeSrc={vinge.src} /> : <Fr videoUrl={VIDEO_URL} showVideo={montrerVideo} vingeSrc={vinge.src} />}
</div>
<dialog class="oeuf-dlg" id="oeufDlg" aria-label={en ? "Vernor Vinge and the singularity" : "Vernor Vinge et la singularité"}>
  <form method="dialog"><button class="oeuf-dlg__x" aria-label={en ? "Close" : "Fermer"}>×</button></form>
  <img src={vinge.src} width={vinge.attributes.width} height={vinge.attributes.height} alt={vingeAlt} loading="lazy" decoding="async" />
</dialog>
</div>

<style is:global>
