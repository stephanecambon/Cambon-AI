  let h=`<rect x="${X(1)}" y="16" width="${X(4.5)-X(1)}" height="274" fill="${peach}" opacity=".55"/>`;
  [0.2,0.3,0.5,1,2,3,4].forEach(v=>{h+=`<line x1="${X(v)}" x2="${X(v)}" y1="16" y2="290" stroke="${grid}"/>`+txt(X(v),310,fr(v,v<1?1:0),{a:'middle',f:MONO,c:mut});});
  h+=`<line x1="${X(1)}" x2="${X(1)}" y1="10" y2="290" stroke="${acc}" stroke-width="2"/>`;
  h+=txt(X(1)-8,334,"← s'essouffle",{a:'end',s:14,w:700,c:mut})+txt(X(1)+8,334,"s'emballe →",{s:14,w:700,c:acc});
  let y=28;
  rows.forEach(rw=>{
    if(rw[0]==='g'){ h+=txt(0,y+8,rw[1].toUpperCase(),{f:MONO,s:11,w:600,c:mut}); y+=28; return; }
    const [n,src,v,a,b]=rw, ai=y>150;
    h+=txt(0,y-2,n,{s:15,w:700,c:ink})+txt(0,y+15,src,{s:12.5,c:mut});
    if(a) h+=`<line x1="${X(a)}" x2="${X(b)}" y1="${y}" y2="${y}" stroke="${sig}" stroke-width="3" stroke-linecap="round" opacity=".55"/>`;
