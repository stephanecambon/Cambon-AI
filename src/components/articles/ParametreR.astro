.pr .fhead{display:flex;flex-direction:column;gap:8px}
.pr .fkick{align-self:flex-start;font:600 12px/1 var(--f-mono);letter-spacing:.1em;text-transform:uppercase;background:var(--f-a);color:var(--f-bg);padding:5px 8px;border-radius:2px}
