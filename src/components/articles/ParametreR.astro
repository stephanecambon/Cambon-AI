function cubes(v){ const MAX=1200, ref=K0; let h='<div class="cubes">';
  const n=Math.min(v,MAX), full=Math.floor(n);
  for(let i=0;i<full;i++) h+= i<ref?'<i class="ref"></i>':'<i></i>';
  if(n-full>0.15) h+= full<ref?'<i class="ref part"></i>':'<i class="part"></i>';
  if(v<ref){ const ghosts=Math.ceil(ref)-Math.ceil(v); for(let i=0;i<ghosts;i++) h+='<i class="ghost"></i>'; }
  if(v>MAX) h+=`<span class="over">+${Math.round(v-MAX).toLocaleString(LOC)} ${tx('cubes de plus','more cubes')}</span>`;
  return h+'</div>'; }

