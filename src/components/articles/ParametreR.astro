<script is:inline>
(function(){
const $=id=>document.getElementById(id);
const fr=(x,d=1)=>x.toLocaleString('fr-FR',{minimumFractionDigits:d,maximumFractionDigits:d});
const css=n=>getComputedStyle(document.querySelector('.pr')).getPropertyValue(n).trim();
const GH=Math.log(3), K0=1.9, G0=K0*GH;  // ×3/an par année de progrès ; accélération METR
const MONO='JetBrains Mono, ui-monospace, monospace', BODY='Source Sans 3, system-ui, sans-serif';
const beta=()=>+$('bet').value;
function P(t,r,b){ const p=b*(r-1); if(Math.abs(p)<1e-9) return K0*t; const q=1-p*G0*t; if(q<=0) return Infinity; return -Math.log(q)/(p*GH); }
function tStar(r,b){ const p=b*(r-1); return p>1e-9?1/(p*G0):Infinity; }
function dateAt(t){ const y=2026+279/365+t, yr=Math.floor(y), m=Math.floor((y-yr)*12); return ['janv.','févr.','mars','avr.','mai','juin','juil.','août','sept.','oct.','nov.','déc.'][m]+' '+yr; }
function fmtX(m){ if(!isFinite(m)) return '∞'; if(m<10) return '×'+fr(m,1); if(m<1000) return '×'+Math.round(m);
  if(m<1e6) return '×'+Number(m.toPrecision(2)).toLocaleString('fr-FR');
  if(m<1e9) return '×'+fr(m/1e6,1)+' million'+(m>=2e6?'s':''); if(m<1e12) return '×'+fr(m/1e9,1)+' milliard'+(m>=2e9?'s':''); return '×10^'+Math.floor(Math.log10(m)); }
const txt=(x,y,s,o={})=>`<text x="${x}" y="${y}" text-anchor="${o.a||'start'}" font-family="${o.f||BODY}" font-size="${o.s||12}" font-weight="${o.w||400}" fill="${o.c}">${s}</text>`;

/* ---- 01 Courbe METR (schéma) ---- */
let metrMode='trend';
document.querySelectorAll('#metrSeg button').forEach(b=>b.addEventListener('click',()=>{metrMode=b.dataset.m; renderMetr();}));
// Scores relevés sur le graphique METR : [nom, date (année décimale), AECI, interne, meilleur du moment, étiquette]
const MODELS=[['Claude 3 Opus',2024.15,124.7,0,1,1],['Claude 3.5 Sonnet',2024.45,130.0,0,1,1],['Claude 3.5 Sonnet (nouveau)',2024.77,133.2,0,1,0],['Claude 3.7 Sonnet',2025.13,141.7,0,1,1],['Claude Opus 4',2025.38,144.8,0,1,1],['Claude Sonnet 4.5',2025.73,147.8,0,1,1],['Claude Opus 4.5',2025.89,152.3,0,1,0],['Claude Opus 4.6',2026.07,157.3,0,1,1],['Mythos Preview (version précoce)',2026.15,162.4,1,1,0],['Mythos Preview',2026.25,165.7,1,1,1],['Opus 4.7',2026.28,160.3,0,0,0],['Opus 4.8',2026.38,163.5,0,0,0],['Mythos 5',2026.42,168.7,0,1,1],['Model 2 (version précoce)',2026.53,171.8,1,1,0],['Opus 5',2026.55,169.3,0,0,0],['Model 2',2026.60,174.1,1,1,0],['Mythos 5.1',2026.60,172.5,0,0,0],['Model 3 (version précoce)',2026.69,176.3,1,1,0],['Opus 5.5',2026.69,174.6,0,0,0],['Model 3',2026.73,177.0,1,1,0],['Model 4',2026.74,178.6,1,1,0]];
function renderMetr(){
  const s=$('svgMetr'), W=760,H=360,L=74,R=120,T=24,B=46, t0=2024.0, t1=2026.85, yLo=120, yHi=190, TB=2025+279/365, TE=2026.74;
  const X=t=>L+(t-t0)/(t1-t0)*(W-L-R), Y=v=>T+(yHi-v)/(yHi-yLo)*(H-T-B);
  const sig=css('--sig'), acc=css('--accent'), mut=css('--muted'), grid=css('--grid'), line=css('--line'), peach=css('--peach'), bg=css('--surface');
  const AB=149.9, A=t=> t<=TB ? AB+15.4*(t-TB) : AB+29*(t-TB), C=t=>AB+15.4*(t-TB);
  document.querySelectorAll('#metrSeg button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.m===metrMode)); $('metrLeg').hidden=metrMode!=='models';
  let h='';
  [120,130,140,150,160,170,180,190].forEach(v=>{h+=`<line x1="${L}" x2="${W-R}" y1="${Y(v)}" y2="${Y(v)}" stroke="${grid}"/>`+txt(L-8,Y(v)+4,v,{a:'end',f:MONO,c:mut});});
  [['janv. 2024',2024],['juil. 2024',2024.5],['janv. 2025',2025],['juil. 2025',2025.5],['janv. 2026',2026],['juil. 2026',2026.5]].forEach(([d,t])=>{h+=txt(X(t),H-24,d,{a:'middle',f:MONO,c:mut});});
  h+=`<text transform="translate(18,${(T+H-B)/2}) rotate(-90)" text-anchor="middle" font-family="${BODY}" font-size="15" font-weight="700" fill="${sig}">AECI (score de capacité)</text>`;
  h+=`<polygon points="${X(TB)},${Y(AB)} ${X(TE)},${Y(A(TE))} ${X(TE)},${Y(C(TE))}" fill="${peach}" opacity=".8"/>`;
  h+=`<line x1="${X(TB)}" x2="${X(TB)}" y1="${T}" y2="${H-B}" stroke="${mut}" stroke-dasharray="4 4"/>`+txt(X(TB)-6,T+10,'rupture · 7 oct. 2025',{a:'end',c:mut,s:13,w:600});
  h+=`<line x1="${X(TB)}" y1="${Y(AB)}" x2="${X(TE)}" y2="${Y(C(TE))}" stroke="${line}" stroke-width="2.5" stroke-dasharray="6 5"/>`;
  h+=`<line x1="${X(2024.15)}" y1="${Y(A(2024.15))}" x2="${X(TB)}" y2="${Y(AB)}" stroke="${sig}" stroke-width="${metrMode==='models'?2.5:4}" stroke-linecap="round"/>`;
  h+=`<line x1="${X(TB)}" y1="${Y(AB)}" x2="${X(TE)}" y2="${Y(A(TE))}" stroke="${acc}" stroke-width="${metrMode==='models'?2.5:4}" stroke-linecap="round"/>`;
  h+=txt(X(TE)+12,Y(C(TE))+4,'sans accélération',{c:mut,s:13});
  h+=txt(X(2025.3),Y(A(2025.3))+32,'+15 points par an',{c:sig,s:14,w:700,a:'middle'});
  if(metrMode!=='models') h+=txt(X(2026.2),Y(A(2026.2))-22,'+29 par an (×1,9)',{c:acc,s:14,w:700,a:'end'});
  else h+=txt(X(TE)+12,Y(C(TE))+26,'pente : +29 par an',{c:acc,s:13,w:700})+txt(X(TE)+12,Y(C(TE))+42,'au lieu de +15',{c:acc,s:13,w:700});
  if(metrMode==='models'){
    MODELS.forEach(([n,d,v,int,fr0,lab])=>{ const c=int?acc:sig, x=X(d), y=Y(v);
      h+=`<g class="pt" data-tip="${n} : ${fr(v,1)}"><circle cx="${x}" cy="${y}" r="14" fill="transparent"/><circle cx="${x}" cy="${y}" r="6" fill="${fr0?c:bg}" stroke="${c}" stroke-width="2"/>${lab?(d>TB?txt(x-10,y+4,n.replace('Claude ',''),{a:'end',s:12,w:600,c:c}):txt(x,y-12,n.replace('Claude ',''),{a:'middle',s:12,w:600,c:c})):''}</g>`; });
    h+=txt(X(TE)+12,Y(178.6)+4,'Model 4 · 178,6',{c:acc,s:14,w:700});
  } else {
    h+=`<circle cx="${X(TE)}" cy="${Y(A(TE))}" r="6" fill="${acc}"/>`+txt(X(TE)+12,Y(A(TE))+4,'Model 4 · 178,6',{c:acc,s:14,w:700});
  }
  s.innerHTML=h;
}


/* ---- 04 Composition ---- */
const verdict=r=> r>1.02?"La boucle s'emballe": r<0.98?"La boucle s'essouffle":"Pile au seuil : exponentielle";
function dialR(){ return +$('lam').value / +$('bet').value; }
let useDial=false, view='curve', unit='years';
function renderDial(){
  $('lamO').textContent=fr(+$('lam').value,2); $('betO').textContent=fr(+$('bet').value,2);
  const lam=+$('lam').value, bt=+$('bet').value;
  $('lamL').textContent=`λ = ${fr(lam,2)} : doubler le nombre de chercheurs accélère le progrès de ${fr((Math.pow(2,lam)-1)*100,0)} %.`;
  $('betL').textContent=`β = ${fr(bt,2)} : à nombre de chercheurs constant, chaque doublement du logiciel prend ${fr((Math.pow(2,bt)-1)*100,0)} % de temps de plus que le précédent.`;
  renderDialCharts(lam,bt);
  const r=dialR(); $('rRes').textContent='r = '+fr(r,2); $('rVer').textContent=verdict(r);
  if(useDial) $('rP').value=Math.min(2.5,Math.max(0.4,r));
  renderProj(); if($('svgMini')) renderMini();
}
['lam','bet'].forEach(id=>$(id).addEventListener('input',renderDial));
function renderDialCharts(lam,bt){
  const acc=css('--accent'), sig=css('--sig'), mut=css('--muted'), grid=css('--grid'), line=css('--line');
  // Les deux graphiques partagent la même échelle verticale : la durée d'un doublement du logiciel,
  // rapportée à celle du premier (×1). λ la raccourcit quand l'effort augmente, β l'allonge à chaque doublement.
  const L=46,R=350,T=30,B=170;
  const lamV=[1,2,4,8].map(e=>Math.pow(e,-lam)), betV=[...Array(6)].map((_,i)=>Math.pow(2,bt*i));
  const vmax=Math.max(2,Math.ceil(betV[5])), Y=v=>B-v/vmax*(B-T);
  const bars=(vals,labels,xlab,ideal)=>{ const bw=(R-L)/vals.length; let h='';
    const ticks=vmax<=4?[0.5,1,2,vmax].filter((v,i,a)=>a.indexOf(v)===i&&v<=vmax):[1,Math.round(vmax/2),vmax];
    ticks.forEach(v=>h+=`<line x1="${L}" x2="${R}" y1="${Y(v)}" y2="${Y(v)}" stroke="${grid}"/>`+txt(L-6,Y(v)+4,'×'+fr(v,v%1?1:0),{a:'end',f:MONO,s:11,c:mut}));
    vals.forEach((v,i)=>{ const x=L+i*bw+6; h+=`<rect x="${x}" y="${Y(v)}" width="${bw-12}" height="${B-Y(v)}" fill="${i?acc:sig}" opacity="${i?0.85:1}" rx="2"/>`+txt(x+(bw-12)/2,B+16,labels[i],{a:'middle',f:MONO,s:11,c:mut}); });
    if(ideal){ const ink=css('--ink'); ideal.forEach((v,i)=>{ if(!i) return; const x=L+i*bw+6; h+=`<rect x="${x+1}" y="${Y(v)}" width="${bw-14}" height="${B-Y(v)-1}" fill="${css('--surface')}" fill-opacity=".35" stroke="${ink}" stroke-width="2" stroke-dasharray="4 3" rx="2"/>`; });
      h+=`<rect x="${R-112}" y="${T-2}" width="14" height="10" fill="none" stroke="${ink}" stroke-width="1.5" stroke-dasharray="3 2"/>`+txt(R-92,T+7,'si λ = 1',{s:10.5,c:mut}); }
    h+=`<line x1="${L}" x2="${R}" y1="${Y(1)}" y2="${Y(1)}" stroke="${line}" stroke-width="2" stroke-dasharray="5 4"/>`;
    h+=txt(L-40,14,'↑ durée pour obtenir un doublement du logiciel',{s:11.5,w:600,c:mut})+txt(L,B+36,'→ '+xlab,{s:11.5,w:600,c:mut});
    return h; };
  $('lamG').innerHTML=bars(lamV,['×1','×2','×4','×8'],'nombre de chercheurs',[1,1/2,1/4,1/8]);
  $('betG').innerHTML=bars(betV,['1er','2e','3e','4e','5e','6e'],'doublements successifs du logiciel');
}

/* ---- 05 Estimations ---- */
function renderEst(){
  const s=$('svgEst'), W=760, L=210, R=24, lo=Math.log(0.2), hi=Math.log(4.5);
