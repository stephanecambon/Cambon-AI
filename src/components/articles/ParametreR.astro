// Deux graphiques : côte à côte sur ordinateur, l'un sous l'autre sur mobile
const PW=()=>NARROW?FW:370, PX=()=>NARROW?0:390, P1=()=>NARROW?{oy:0,ph:FH/2,L:66,noYlab:true}:{}, P2=()=>NARROW?{oy:FH/2,ph:FH/2,L:66,noYlab:true}:{}; // mobile : titres sans axe vertical nommé
function pl(pts,tmax,X,Y,stroke,w,dash){ // polyline coupée à tmax
  let d='', on=false;
  for(let i=0;i<pts.length;i++){ const [t,v]=pts[i];
    if(t>tmax){ if(i>0 && on){ const [t0,v0]=pts[i-1]; const v1=v0+(v-v0)*(tmax-t0)/(t-t0); d+=`L${X(tmax).toFixed(1)},${Y(v1).toFixed(1)}`;} break; }
    d+=(on?'L':'M')+X(t).toFixed(1)+','+Y(v).toFixed(1); on=true; }
  return d?`<path d="${d}" fill="none" stroke="${stroke}" stroke-width="${w}" stroke-linecap="round" stroke-linejoin="round" ${dash?'stroke-dasharray="6 5"':''}/>`:'';
