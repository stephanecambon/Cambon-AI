---
import Newsletter from './Newsletter.astro';
import Picto from './Picto.astro';
import { texts, routes, type Lang } from '../i18n';
import { CONTACT_EMAIL, newsletterEnabled } from '../config';

interface Props {
  lang: Lang;
  /** Chemin de la page courante. */
  path: string;
}

const { lang, path } = Astro.props;
const t = texts[lang].footer;
---
<footer class="site-footer">
  <div class="container">
    {newsletterEnabled && <Newsletter lang={lang} path={path} />}
    <div class="site-footer__inner">
      <p class="site-footer__brand"><Picto size={22} />{t.company}</p>
      <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
      <p class="site-footer__legal">
        <a href={routes.legal[lang]}>{t.legal}</a>
        <a href={routes.privacy[lang]}>{t.privacy}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    background: var(--surface);
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    padding-block: 28px;
  }
  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .site-footer a {
    color: var(--text-2);
  }
  /* Mobile : zones tactiles d'au moins 44 px */
  @media (max-width: 860px) {
    .site-footer__inner {
      row-gap: 0;
      padding-block: 18px;
    }
    .site-footer a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
