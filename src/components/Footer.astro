---
import Newsletter from './Newsletter.astro';
import { texts, routes, type Lang } from '../i18n';
import { CONTACT_EMAIL, newsletterEnabled } from '../config';

interface Props {
  lang: Lang;
  /** Chemin de la page courante. */
  path: string;
}

const { lang, path } = Astro.props;
const t = texts[lang].footer;
---
<footer class="site-footer">
  <div class="container">
    {newsletterEnabled && <Newsletter lang={lang} path={path} />}
    <div class="site-footer__inner">
      <p>{t.company}</p>
      <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
      <p class="site-footer__legal">
        <a href={routes.legal[lang]}>{t.legal}</a>
        <a href={routes.privacy[lang]}>{t.privacy}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    background: var(--paper);
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    padding-block: 28px;
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .site-footer a {
    color: var(--text-2);
  }
</style>
