---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { texts, routes, LANGS, type Lang, type Alternates } from '../i18n';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Adresse de cette page dans chaque langue (lien FR · EN, hreflang, canonical). */
  alternates?: Alternates;
  noindex?: boolean;
}

const { lang, title, description, alternates, noindex = false } = Astro.props;
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = alternates ? abs(alternates[lang]) : undefined;
const ogLocale = { fr: 'fr_FR', en: 'en_US' }[lang];
const ogImage = abs(`/og-${lang}.png`);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates && LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(alternates[l])} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={abs(alternates.fr)} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cambon AI" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={texts[lang].meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-barlow-condensed" preload />
    <Font cssVariable="--font-barlow" preload={[{ weight: '400' }, { weight: '600' }]} />
  </head>
  <body>
    <Header lang={lang} alternates={alternates ?? routes.home} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} path={Astro.url.pathname} />
  </body>
</html>
