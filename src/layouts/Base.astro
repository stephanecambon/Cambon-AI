---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { texts, routes, LANGS, type Lang, type Alternates } from '../i18n';
import { toJsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Adresse de cette page dans chaque langue (lien FR · EN, hreflang, canonical). */
  alternates?: Alternates;
  noindex?: boolean;
  /** Données structurées Schema.org (JSON-LD). */
  jsonLd?: unknown;
  /** Image de partage propre à la page (chemin absolu sur le site) et sa description. */
  ogImage?: { src: string; width: number; height: number; alt: string };
}

const { lang, title, description, alternates, noindex = false, jsonLd, ogImage: pageOg } = Astro.props;
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = alternates ? abs(alternates[lang]) : undefined;
const ogLocale = { fr: 'fr_FR', en: 'en_US' }[lang];
const og = pageOg
  ? { ...pageOg, src: abs(pageOg.src) }
  : { src: abs(`/og-${lang}.png`), width: 1200, height: 630, alt: texts[lang].meta.ogImageAlt };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates && LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(alternates[l])} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={abs(alternates.fr)} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cambon AI" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={og.src} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" is:inline set:html={toJsonLd(jsonLd)} />}

    <Font cssVariable="--font-barlow-condensed" preload />
    <Font cssVariable="--font-barlow" preload={[{ weight: '400' }, { weight: '600' }]} />
  </head>
  <body>
    <Header lang={lang} alternates={alternates ?? routes.home} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} path={Astro.url.pathname} />
  </body>
</html>
